#!/usr/bin/env bash
# Enforce Conventional Commits 1.0.0 on the subject line.
# Installed by: git config core.hooksPath .githooks
set -euo pipefail

MSG_FILE="$1"

# Strip a trailing CR so the hook behaves identically on Windows checkouts,
# and drop comment lines so `git commit` templates do not become the subject.
FIRST_LINE="$(grep -v '^#' "$MSG_FILE" | sed -e 's/\r$//' -e '/^[[:space:]]*$/d' | head -n1 || true)"

if [ -z "$FIRST_LINE" ]; then
  echo "Rejected: empty commit message." >&2
  exit 1
fi

# Merge, revert, fixup and squash commits are generated by git; let them through.
case "$FIRST_LINE" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

TYPES='feat|fix|docs|refactor|perf|test|build|ci|chore|style|revert'

if ! printf '%s\n' "$FIRST_LINE" | grep -qE "^(${TYPES})(\([a-z0-9._/-]+\))?!?: .+"; then
  cat >&2 <<EOF
Rejected: commit subject must follow Conventional Commits.
  <type>[optional scope]: <description>
  types: ${TYPES//|/ }
  got:   ${FIRST_LINE}
EOF
  exit 1
fi

if [ "${#FIRST_LINE}" -gt 72 ]; then
  echo "Rejected: subject line is ${#FIRST_LINE} characters, limit is 72." >&2
  exit 1
fi

exit 0
